// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  AGENT
  USER
}

enum MediaType {
  IMAGE
  VIDEO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum OrderStatus {
  DRAFT
  UNPAID
  PAID
  PROCESSING
  COMPLETED
  CANCELED
  REFUNDED
}

enum PlanInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum InvoiceType {
  PLAN
  ORDER
}

model TempAccount {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String? // user's name
  passwordHash String // store hashed password, same as User
  token        String   @unique // random string sent in email link
  expiresAt    DateTime // when the token/otp becomes invalid
  attempts     Int      @default(0) // optional: number of verification attempts

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  name         String?
  passwordHash String?

  role             Role    @default(USER)
  stripeCustomerId String?

  // password reset
  resetToken        String?
  resetTokenExpires DateTime?

  currentSubscriptionId Int?
  currentSubscription   Subscription? @relation("CurrentSubscription", fields: [currentSubscriptionId], references: [id])

  // relations
  subscriptions  Subscription[]
  orders         Order[]        @relation("UserOrders")
  assignedOrders Order[]        @relation("AgentAssignedOrders")
  agentProfile   AgentProfile?  @relation("AgentProfileUser")
  invoices       Invoice[]
  shopifyStores  ShopifyStore[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  productMappings ProductMapping[]
  variantMappings VariantMapping[]
}

model Plan {
  id              Int          @id @default(autoincrement())
  name            String
  description     String?
  oldPrice        Float?
  price           Float
  interval        PlanInterval
  stripeProductId String?
  stripePriceId   String?
  active          Boolean      @default(true)
  features        Json?
  mostPopular     Boolean      @default(false)
  sortOrder       Int          @default(0)

  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id                    Int                @id @default(autoincrement())
  user                  User               @relation(fields: [userId], references: [id])
  userId                Int
  plan                  Plan               @relation(fields: [planId], references: [id])
  planId                Int
  stripeSubscriptionId  String?
  status                SubscriptionStatus @default(TRIALING)
  startsAt              DateTime?
  endsAt                DateTime?
  trialEndsAt           DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  usage                 Json?
  latestStripeInvoiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User User[] @relation("CurrentSubscription")
}

model Invoice {
  id                   Int          @id @default(autoincrement())
  stripeInvoiceId      String       @unique
  user                 User         @relation(fields: [userId], references: [id])
  userId               Int
  stripeSubscriptionId String?
  amountCents          Int
  taxCents             Int
  currency             String
  status               String
  pdfUrl               String?
  hostedUrl            String?
  paidAt               DateTime?
  type                 InvoiceType? // PLAN or ORDER
  periodStart          DateTime
  periodEnd            DateTime
  createdAt            DateTime     @default(now())
  Order                Order[]
}

model Category {
  id           Int                   @id @default(autoincrement())
  translations CategoryTranslation[]
  products     Product[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model CategoryTranslation {
  id          Int      @id @default(autoincrement())
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  Int
  locale      String
  title       String
  description String?

  @@unique([categoryId, locale])
}

model Product {
  id              Int     @id @default(autoincrement())
  sku             String? @unique
  price           Float?
  compareAtPrice  Float?
  sellingPrice    Float?
  currency        String?
  popularityScore Int     @default(0)
  shopifyId       String?
  shopifyImported Boolean @default(false)

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId Int?

  translations    ProductTranslation[]
  media           Media[]
  suppliers       Supplier[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  isActive        Boolean              @default(true)
  views           Int                  @default(0)
  likes           Int                  @default(0)
  orderItems      OrderItem[]
  productOptions  ProductOption[]
  productVariants ProductVariant[]
  productMappings ProductMapping[]
  variantMappings VariantMapping[]
}

model ProductOption {
  id        Int    @id @default(autoincrement())
  productId Int
  name      String // "Color", "Size", "Material"
  position  Int // 1, 2, or 3 (Shopify allows max 3 options)
  values    Json // e.g., ["Red", "Blue", "Green"] or ["S", "M", "L"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
}

// Product variants (combinations of options)
model ProductVariant {
  id        Int @id @default(autoincrement())
  productId Int

  // Option values for this variant
  option1 String? // e.g., "Red"
  option2 String? // e.g., "Small"
  option3 String? // e.g., "Cotton"

  // Pricing and inventory
  price          String
  compareAtPrice String? // Original price (for discounts)
  costPrice      String? // Your cost
  sku            String? // Optional SKU

  // Inventory
  inventory      Int     @default(0)
  trackInventory Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantMappings VariantMapping[]
  orderItems      OrderItem[]

  @@index([productId])
  @@index([sku])
}

// Mapping between Product Genius variants and Shopify variants
model VariantMapping {
  id               Int    @id @default(autoincrement())
  userId           Int
  variantId        Int // Your variant ID
  productId        Int // Your product ID (for easier queries)
  shopifyVariantId String // Shopify's variant ID
  shopifyProductId String // Shopify's product ID
  shop             String // e.g., "store.myshopify.com"

  sku String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id])

  @@unique([shopifyVariantId, shop])
  @@index([variantId])
  @@index([productId])
  @@index([shop])
}

model ProductMapping {
  id               Int      @id @default(autoincrement())
  userId           Int
  productId        Int
  shopifyProductId String
  shopifyStoreId   Int
  shop             String
  createdAt        DateTime @default(now())

  product      Product      @relation(fields: [productId], references: [id])
  shopifyStore ShopifyStore @relation(fields: [shopifyStoreId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([productId, shop])
}

model ProductTranslation {
  id          Int     @id @default(autoincrement())
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   Int
  locale      String
  title       String
  description String  @db.Text

  @@unique([productId, locale])
}

model Media {
  id        Int       @id @default(autoincrement())
  product   Product?  @relation(fields: [productId], references: [id])
  productId Int?
  url       String
  poster    String?
  provider  String?
  type      MediaType
  alt       String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
}

model Supplier {
  id          Int     @id @default(autoincrement())
  product     Product @relation(fields: [productId], references: [id])
  productId   Int
  url         String?
  marketplace String?
  price       Float?
  currency    String?
  isInternal  Boolean @default(false)
  notes       String?

  @@index([productId])
}

model Order {
  id             Int     @id @default(autoincrement())
  orderNumber    String
  shopifyOrderId String? @unique

  shopifyStoreId Int?
  shopifyStore   ShopifyStore? @relation(fields: [shopifyStoreId], references: [id])

  // relation to buyer (explicit relation name)
  user   User @relation("UserOrders", fields: [userId], references: [id])
  userId Int

  // relation to agent (explicit relation name)
  agent   User? @relation("AgentAssignedOrders", fields: [agentId], references: [id])
  agentId Int?

  invoiceId Int? // Stripe Invoice ID
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  items      OrderItem[]
  totalCents Int
  currency   String
  status     OrderStatus @default(UNPAID)

  // delivery address
  deliveryName     String?
  deliveryPhone    String?
  deliveryEmail    String?
  deliveryAddress1 String?
  deliveryAddress2 String?
  deliveryCity     String?
  deliveryState    String?
  deliveryZip      String?
  deliveryCountry  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id             Int    @id @default(autoincrement())
  title          String
  unitPriceCents Int
  quantity       Int

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  productVariantId Int?
  ProductVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
}

model AgentProfile {
  id Int @id @default(autoincrement())

  // explicit relation name between AgentProfile and User
  user   User @relation("AgentProfileUser", fields: [userId], references: [id])
  userId Int  @unique

  companyName   String?
  contactNumber String?
  details       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ShopifyStore {
  id          Int      @id @default(autoincrement())
  userId      Int
  shop        String   @unique
  name        String?
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id])
  ProductMapping ProductMapping[]
  Order          Order[]
}
