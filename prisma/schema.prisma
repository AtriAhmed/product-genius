// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  AGENT
  USER
}

enum MediaType {
  IMAGE
  VIDEO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum OrderStatus {
  DRAFT
  UNPAID
  PAID
  PROCESSING
  COMPLETED
  CANCELED
  REFUNDED
}

enum PlanInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum InvoiceType {
  PLAN
  ORDER
}

model TempAccount {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String? // user's name
  passwordHash String   @map("password_hash")
  token        String   @unique // random string sent in email link
  expiresAt    DateTime @map("expires_at")
  attempts     Int      @default(0) // optional: number of verification attempts

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("temp_account")
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  name         String?
  passwordHash String? @map("password_hash")

  role             Role    @default(USER)
  stripeCustomerId String? @map("stripe_customer_id")

  // password reset
  resetToken        String?   @map("reset_token")
  resetTokenExpires DateTime? @map("reset_token_expires")

  currentSubscriptionId Int?          @map("current_subscription_id")
  currentSubscription   Subscription? @relation("current_subscription", fields: [currentSubscriptionId], references: [id])

  // relations
  subscriptions  Subscription[]
  orders         Order[]        @relation("user_orders")
  assignedOrders Order[]        @relation("agent_assigned_orders")
  agentProfile   AgentProfile?  @relation("agent_profile_user")
  invoices       Invoice[]
  shopifyStores  ShopifyStore[]

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  productMappings ProductMapping[]
  variantMappings VariantMapping[]
  notifications   Notification[]

  @@map("user")
}

model Plan {
  id              Int     @id @default(autoincrement())
  name            String
  description     String?
  stripeProductId String? @map("stripe_product_id")
  features        Json?
  active          Boolean @default(true)
  mostPopular     Boolean @default(false) @map("most_popular")
  sortOrder       Int     @default(0) @map("sort_order")
  isFree          Boolean @default(false) @map("is_free")

  prices        PlanPrice[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  products      Product[]      @relation("plan_products")

  @@map("plan")
}

model PlanPrice {
  id             Int          @id @default(autoincrement())
  planId         Int          @map("plan_id")
  interval       PlanInterval // weekly, monthly, yearly, etc
  price          Float?
  compareAtPrice Float?       @map("compare_at_price")
  stripePriceId  String?      @map("stripe_price_id")

  plan Plan @relation(fields: [planId], references: [id])

  @@map("plan_price")
}

model Subscription {
  id                    Int                @id @default(autoincrement())
  user                  User               @relation(fields: [userId], references: [id])
  userId                Int                @map("user_id")
  plan                  Plan               @relation(fields: [planId], references: [id])
  planId                Int                @map("plan_id")
  interval              PlanInterval? // Current billing interval
  stripeSubscriptionId  String?            @map("stripe_subscription_id")
  status                SubscriptionStatus @default(TRIALING)
  startsAt              DateTime?          @map("starts_at")
  endsAt                DateTime?          @map("ends_at")
  trialEndsAt           DateTime?          @map("trial_ends_at")
  cancelAtPeriodEnd     Boolean            @default(false) @map("cancel_at_period_end")
  usage                 Json?
  latestStripeInvoiceId String?            @map("latest_stripe_invoice_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  User User[] @relation("current_subscription")

  @@map("subscription")
}

model Invoice {
  id                   Int          @id @default(autoincrement())
  stripeInvoiceId      String       @unique @map("stripe_invoice_id")
  user                 User         @relation(fields: [userId], references: [id])
  userId               Int          @map("user_id")
  stripeSubscriptionId String?      @map("stripe_subscription_id")
  amountCents          Int          @map("amount_cents")
  taxCents             Int          @map("tax_cents")
  currency             String
  status               String
  pdfUrl               String?      @map("pdf_url")
  hostedUrl            String?      @map("hosted_url")
  paidAt               DateTime?    @map("paid_at")
  type                 InvoiceType? // PLAN or ORDER
  periodStart          DateTime     @map("period_start")
  periodEnd            DateTime     @map("period_end")
  createdAt            DateTime     @default(now()) @map("created_at")
  Order                Order[]

  @@map("invoice")
}

model Category {
  id           Int                   @id @default(autoincrement())
  translations CategoryTranslation[]
  products     Product[]
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@map("category")
}

model CategoryTranslation {
  id          Int      @id @default(autoincrement())
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  Int      @map("category_id")
  locale      String
  title       String
  description String?

  @@unique([categoryId, locale])
  @@map("category_translation")
}

model Product {
  id              Int     @id @default(autoincrement())
  sku             String? @unique
  price           Float?
  compareAtPrice  Float?  @map("compare_at_price")
  sellingPrice    Float?  @map("selling_price")
  currency        String?
  popularityScore Int     @default(0) @map("popularity_score")
  shopifyId       String? @map("shopify_id")
  shopifyImported Boolean @default(false) @map("shopify_imported")

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId Int?      @map("category_id")

  plans           Plan[]               @relation("plan_products")
  translations    ProductTranslation[]
  media           Media[]
  suppliers       Supplier[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  isActive        Boolean              @default(true) @map("is_active")
  views           Int                  @default(0)
  likes           Int                  @default(0)
  options         ProductOption[]
  variants        ProductVariant[]
  productMappings ProductMapping[]
  variantMappings VariantMapping[]
  orderItems      OrderItem[]

  @@map("product")
}

model ProductOption {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  name      String // "Color", "Size", "Material"
  position  Int // 1, 2, or 3 (Shopify allows max 3 options)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product                    Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  values                     ProductOptionValue[]
  productVariantOptionValues ProductVariantOptionValue[]

  @@unique([productId, position])
  @@map("product_option")
}

model ProductOptionValue {
  id       Int    @id @default(autoincrement())
  optionId Int    @map("option_id")
  value    String // "Red", "Blue", "Green", "S", "M", "L", etc.
  position Int    @default(0) // For ordering values within an option

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  option                     ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  productVariantOptionValues ProductVariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId])
  @@map("product_option_value")
}

// Product variants (combinations of options)
model ProductVariant {
  id        Int @id @default(autoincrement())
  productId Int @map("product_id")

  // Pricing and inventory
  price          Float
  compareAtPrice Float?  @map("compare_at_price")
  sellingPrice   Float?  @map("selling_price")
  sku            String? // Optional SKU

  // Inventory
  inventory      Int     @default(0)
  trackInventory Boolean @default(false) @map("track_inventory")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  product         Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantMappings VariantMapping[]
  options         ProductVariantOptionValue[]
  orderItems      OrderItem[]

  @@index([productId])
  @@index([sku])
  @@map("product_variant")
}

model ProductVariantOptionValue {
  id Int @id @default(autoincrement())

  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  productVariantId Int            @map("product_variant_id")

  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId Int           @map("option_id")

  value   ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)
  valueId Int                @map("value_id")

  @@unique([productVariantId, optionId])
  @@map("product_variant_option_value")
}

// Mapping between WinWaterfall variants and Shopify variants
model VariantMapping {
  id               Int    @id @default(autoincrement())
  userId           Int    @map("user_id")
  variantId        Int    @map("variant_id") // Your variant ID
  productId        Int    @map("product_id") // Your product ID (for easier queries)
  shopifyVariantId String @map("shopify_variant_id") // Shopify's variant ID
  shopifyProductId String @map("shopify_product_id") // Shopify's product ID
  shopifyStoreId   Int    @default(1) @map("shopify_store_id")
  shop             String // e.g., "store.myshopify.com"

  sku String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id])
  shopifyStore ShopifyStore   @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)

  @@unique([shopifyVariantId, shop])
  @@index([variantId])
  @@index([productId])
  @@index([shop])
  @@map("variant_mapping")
}

model ProductMapping {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  productId        Int      @map("product_id")
  shopifyProductId String   @map("shopify_product_id")
  shopifyStoreId   Int      @map("shopify_store_id")
  shop             String
  createdAt        DateTime @default(now()) @map("created_at")

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopifyStore ShopifyStore @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, shop])
  @@map("product_mapping")
}

model ProductTranslation {
  id          Int     @id @default(autoincrement())
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   Int     @map("product_id")
  locale      String
  title       String
  description String  @db.Text

  @@unique([productId, locale])
  @@map("product_translation")
}

model Media {
  id        Int       @id @default(autoincrement())
  product   Product?  @relation(fields: [productId], references: [id])
  productId Int?      @map("product_id")
  url       String
  poster    String?
  provider  String?
  type      MediaType
  alt       String?
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("media")
}

model Supplier {
  id          Int     @id @default(autoincrement())
  product     Product @relation(fields: [productId], references: [id])
  productId   Int     @map("product_id")
  url         String?
  marketplace String?
  price       Float?
  currency    String?
  isInternal  Boolean @default(false) @map("is_internal")
  notes       String?

  @@index([productId])
  @@map("supplier")
}

model Order {
  id             Int     @id @default(autoincrement())
  orderNumber    String  @map("order_number")
  shopifyOrderId String? @unique @map("shopify_order_id")
  trackingNumber String? @map("tracking_number")
  trackingUrl    String? @map("tracking_url")

  shopifyStoreId Int?          @map("shopify_store_id")
  shopifyStore   ShopifyStore? @relation(fields: [shopifyStoreId], references: [id])

  // relation to buyer (explicit relation name)
  user   User @relation("user_orders", fields: [userId], references: [id])
  userId Int  @map("user_id")

  // relation to agent (explicit relation name)
  agent   User? @relation("agent_assigned_orders", fields: [agentId], references: [id])
  agentId Int?  @map("agent_id")

  invoiceId Int?     @map("invoice_id") // Stripe Invoice ID
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  items      OrderItem[]
  totalCents Int         @map("total_cents")
  currency   String
  status     OrderStatus @default(UNPAID)

  // delivery address
  deliveryName     String? @map("delivery_name")
  deliveryPhone    String? @map("delivery_phone")
  deliveryEmail    String? @map("delivery_email")
  deliveryAddress1 String? @map("delivery_address1")
  deliveryAddress2 String? @map("delivery_address2")
  deliveryCity     String? @map("delivery_city")
  deliveryState    String? @map("delivery_state")
  deliveryZip      String? @map("delivery_zip")
  deliveryCountry  String? @map("delivery_country")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("order")
}

model OrderItem {
  id             Int    @id @default(autoincrement())
  title          String
  unitPriceCents Int    @map("unit_price_cents")
  quantity       Int

  productId Int?     @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId Int?            @map("variant_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Independent product data
  productTitle       String  @map("product_title")
  productDescription String? @map("product_description") @db.Text
  productSku         String? @map("product_sku")

  // Option values (stored as JSON for flexibility)
  variantOptions Json? @map("variant_options") // e.g., {"Color": "Red", "Size": "M"}

  // Images and media
  imageUrl String? @map("image_url")
  imageAlt String? @map("image_alt")

  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_item")
}

model AgentProfile {
  id Int @id @default(autoincrement())

  // explicit relation name between AgentProfile and User
  user   User @relation("agent_profile_user", fields: [userId], references: [id])
  userId Int  @unique @map("user_id")

  companyName   String?  @map("company_name")
  contactNumber String?  @map("contact_number")
  details       Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("agent_profile")
}

model ShopifyStore {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  shop        String   @unique
  name        String?
  accessToken String   @map("access_token")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id])
  productMappings ProductMapping[]
  Order           Order[]
  variantMappings VariantMapping[]

  @@map("shopify_store")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationEvent {
  PRICE_CHANGE
  CARD_EXPIRED
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_RENEWED
  ORDER_CREATED
  ORDER_ASSIGNED
  ORDER_SHIPPED
  ORDER_REFUNDED
}

model Notification {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String?
  message String
  link    String?

  type  NotificationType  @default(INFO)
  event NotificationEvent

  read   Boolean   @default(false)
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notification")
}
